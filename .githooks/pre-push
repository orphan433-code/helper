#!/bin/bash
# Перед push: поднять VERSION и попросить один повторный push
# (без вложенного push — иначе git печатает ложный error).
set -euo pipefail

remote="${1:-origin}"

while read -r _local_ref _local_sha _remote_ref _remote_sha; do
  :
done || true

if [[ "${SKIP_VERSION_BUMP:-}" == "1" ]]; then
  exit 0
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

subj="$(git log -1 --pretty=%s 2>/dev/null || true)"
# Уже забампили — пускаем обычный push без ошибок.
if [[ "$subj" == "chore: bump version to "* ]]; then
  exit 0
fi

chmod +x scripts/bump_version.sh 2>/dev/null || true
NEW="$(bash scripts/bump_version.sh)"
OLD="$(git show HEAD:VERSION 2>/dev/null | tr -d '[:space:]' || true)"

if [[ "$NEW" == "$OLD" ]]; then
  exit 0
fi

git add VERSION
if git diff --cached --quiet -- VERSION; then
  exit 0
fi

git commit -m "chore: bump version to ${NEW}"
echo ""
echo "VERSION → ${NEW}"
echo "Сделай ещё раз:  git push ${remote}"
echo "(второй push уже без бампа, уйдёт чисто)"
exit 1
